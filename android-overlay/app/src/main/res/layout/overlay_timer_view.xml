<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/overlayRoot"
  android:layout_width="wrap_content"
  android:layout_height="wrap_content"
  android:background="@drawable/bg_overlay_card"
  android:elevation="16dp"
  android:minWidth="220dp"
  android:orientation="vertical"
  android:padding="14dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <View
      android:id="@+id/overlayStatusDot"
      android:layout_width="8dp"
      android:layout_height="8dp"
      android:background="@drawable/bg_overlay_status_idle" />

    <TextView
      android:id="@+id/overlayStatusText"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:text="@string/timer_idle"
      android:textColor="@color/overlay_muted"
      android:textSize="12sp" />

    <TextView
      android:id="@+id/expandToggle"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="end"
      android:text="@string/overlay_expand"
      android:textColor="@color/overlay_muted"
      android:textSize="12sp" />
  </LinearLayout>

  <TextView
    android:id="@+id/overlayTime"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="00:00:00"
    android:textColor="@color/overlay_text"
    android:textSize="30sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/overlayAction"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="当前动作：尚未开始"
    android:textColor="@color/overlay_text"
    android:textSize="13sp" />

  <TextView
    android:id="@+id/overlayHint"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:text="@string/overlay_drag_hint"
    android:textColor="@color/overlay_muted"
    android:textSize="11sp" />

  <LinearLayout
    android:id="@+id/overlayControls"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:visibility="gone">

    <TextView
      android:id="@+id/overlayStart"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/bg_overlay_chip"
      android:paddingHorizontal="12dp"
      android:paddingVertical="8dp"
      android:text="@string/start_timer"
      android:textColor="@color/overlay_text"
      android:textSize="12sp" />

    <TextView
      android:id="@+id/overlayPause"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:background="@drawable/bg_overlay_chip"
      android:paddingHorizontal="12dp"
      android:paddingVertical="8dp"
      android:text="@string/pause_timer"
      android:textColor="@color/overlay_text"
      android:textSize="12sp" />

    <TextView
      android:id="@+id/overlayReset"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:background="@drawable/bg_overlay_chip"
      android:paddingHorizontal="12dp"
      android:paddingVertical="8dp"
      android:text="@string/reset_timer"
      android:textColor="@color/overlay_text"
      android:textSize="12sp" />
  </LinearLayout>
</LinearLayout>
