{
  "name": "knowledge-habit-tracker",
  "version": "1.0.0",
  "description": "渡鸦大人的个人工具站（humansneeds.com）：习惯记录、知识共建共享、需求图谱。",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "start:community": "node scripts/start-community.cjs",
    "dev": "nodemon server.js",
    "desktop": "electron electron/main.js",
    "seed:bundle": "node scripts/build-seed-bundle.js",
    "prototype": "node prototypes/interaction-review/server.cjs 3102",
    "prototype:check": "node scripts/check-prototype.js",
    "prototype:comments": "node scripts/read-prototype-comments.js",
    "trial": "node prototypes/open-design-trial/server.cjs 3110",
    "trial:check": "node scripts/trial-browser-check.cjs",
    "trial:test": "vitest run tests/trial",
    "test": "vitest run",
    "test:community": "vitest run --configLoader native --config prototypes/community-review/integration/audit.config.cjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check.js"
  },
  "keywords": [
    "personal-site",
    "habit-tracking",
    "knowledge-worker",
    "offline-first",
    "privacy-focused",
    "time-management",
    "productivity"
  ],
  "author": "渡鸦大人 (puppetcat-fire)",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/node": "^24.10.14",
    "electron": "^37.2.0",
    "eslint": "^9.39.3",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/puppetcat-fire/knowledge-habit-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/puppetcat-fire/knowledge-habit-tracker/issues"
  },
  "homepage": "https://humansneeds.com",
  "engines": {
    "node": ">=20"
  }
}
