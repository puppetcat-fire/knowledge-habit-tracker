{
  "name": "knowledge-habit-tracker",
  "version": "1.0.0",
  "description": "A privacy-focused, offline-first habit tracking system designed specifically for knowledge workers and lifelong learners.",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "start:community": "node scripts/start-community.cjs",
    "dev": "nodemon server.js",
    "desktop": "electron electron/main.js",
    "seed:bundle": "node scripts/build-seed-bundle.js",
    "test": "vitest run",
    "test:community": "vitest run --configLoader native --config prototypes/open-design-trial/integration/audit.config.cjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check.js"
  },
  "keywords": [
    "habit-tracking",
    "knowledge-worker",
    "offline-first",
    "privacy-focused",
    "time-management",
    "productivity"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/node": "^24.10.14",
    "electron": "^37.2.0",
    "eslint": "^9.39.3",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/knowledge-habit-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/knowledge-habit-tracker/issues"
  },
  "homepage": "https://github.com/your-username/knowledge-habit-tracker#readme"
}
