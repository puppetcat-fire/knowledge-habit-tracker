# Default: local sandbox only
PORT=3000
HOST=127.0.0.1

# Optional: move feedback logs elsewhere
DATA_DIR=./data

# Optional: only needed when there is a reverse proxy / public domain in front
ALLOWED_ORIGINS=

# Optional: basic in-memory rate limit for /api/*
ENABLE_RATE_LIMIT=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=60

# Optional: set when running behind Nginx or another proxy
TRUST_PROXY=false
