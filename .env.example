# 本地默认：只在这台机器上打开
PORT=3000
HOST=127.0.0.1

# 反馈日志、账号、节点数据的落盘位置
DATA_DIR=./data

# 放到公网时：只允许你的域名来写反馈
# ALLOWED_ORIGINS=https://humansneeds.com,https://www.humansneeds.com
ALLOWED_ORIGINS=

# /api/* 的基础限流
ENABLE_RATE_LIMIT=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=60

# 在 Nginx / Caddy 后面时打开，才能拿到真实客户端 IP
TRUST_PROXY=false

# 上 HTTPS 后打开：会话 Cookie 带 Secure
COOKIE_SECURE=false

# 旧版知识平台单独占着 3001。设了这个端口，会起一个只做 301 的监听，
# 把旧书签导到 /platform/。不设就不监听第二个端口。
# LEGACY_PLATFORM_PORT=3001
