# 知识习惯跟踪器 - 安全配置示例
# 复制此文件为 .env 并修改配置

# 服务器配置
PORT=3000
HOST=localhost  # 设置为 0.0.0.0 允许网络访问，localhost 仅本地访问

# 安全配置
ENABLE_CORS=false  # 设置为 true 启用CORS
CORS_ORIGIN=http://localhost:8082  # 允许访问的来源（知识库地址）

# API密钥（可选）
# API_KEY=your-secret-api-key-here

# 速率限制（可选）
ENABLE_RATE_LIMIT=false  # 设置为 true 启用速率限制

# 日志级别
LOG_LEVEL=info